# Tiered: the tuned configuration with the 3-level tiered-L0 seqIndex.
# 1.05-1.09M 1 KB overwrites/s at space amp ~2.1 on the reference host.
# Same as tuned.env plus --lsd-levels 3 --lsd-tiered-l0 (LSDTieredL0 on the
# couchbaselabs/magma-research `research` branch). Results in ../README.md.
VB=128
SERVER_FLAGS="--shards 8 --mem-quota 17179869184 --auto-tune --max-writers 256 \
  --flushers 40 --write-queue-mem 1073741824 --no-compression \
  --index-compression-lz4 --data-block-size 4096 --io-queue-depth 16 \
  --compactors 64 --batch-sort always --shared-wal --shared-wal-chunk-size 8388608 \
  --shared-wal-chunks 24 --shared-wal-flushers 4 --io-threads 32 --readers 8 \
  --lsd-frag-ratio 0.5 --key-warm-new-tables --sstable-write-buffer 1048576 \
  --key-block-size 4096 --lsd-levels 3 --lsd-tiered-l0"
# Idle writers otherwise spin 2000 iterations before parking; with the tuner
# sizing the pool this costs cores for nothing.
SERVER_ENV="MAGMA_WRITER_SPIN_ITERS=0"
