# Baseline: the configuration every overwrite measurement started from.
# 64 kvstores, writers pinned at 32, tuner off, magma defaults for caching,
# readahead, write buffer and key-index block size.
VB=64
SERVER_FLAGS="--shards 8 --mem-quota 17179869184 --writers 32 --flushers 40 \
  --write-queue-mem 1073741824 --no-compression --index-compression-lz4 \
  --data-block-size 4096 --io-queue-depth 16 --compactors 64 \
  --batch-sort always --shared-wal --shared-wal-chunk-size 8388608 \
  --shared-wal-chunks 24 --shared-wal-flushers 4 --io-threads 32 --readers 8 \
  --lsd-frag-ratio 0.5"
SERVER_ENV=""
